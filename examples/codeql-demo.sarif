{
  "version": "2.1.0",
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "CodeQL",
          "version": "2.20.0",
          "rules": [
            {
              "id": "java/sql-injection",
              "shortDescription": {"text": "SQL query built from user-controlled sources"},
              "properties": {"security-severity": "8.9", "tags": ["security", "external/cwe/cwe-089"]},
              "relationships": [{"target": {"id": "external/cwe/cwe-089"}, "kinds": ["superset"]}],
              "helpUri": "https://codeql.github.com/codeql-query-help/java/sql-injection/"
            },
            {
              "id": "java/command-line-injection",
              "shortDescription": {"text": "Arbitrary command line construction from user input"},
              "properties": {"security-severity": "9.6", "tags": ["security", "external/cwe/cwe-078"]},
              "relationships": [{"target": {"id": "external/cwe/cwe-078"}, "kinds": ["superset"]}],
              "helpUri": "https://codeql.github.com/codeql-query-help/java/command-line-injection/"
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "java/sql-injection",
          "level": "error",
          "message": {"text": "{0} flows to {1} in {2}, allowing control of an SQL query.", "arguments": ["userInput", "executeQuery", "query"]},
          "locations": [{"physicalLocation": {"artifactLocation": {"uri": "src/main/java/lab/AuditPractice.java"}, "region": {"startLine": 11, "startColumn": 38}}}],
          "codeFlows": [
            {
              "threadFlows": [
                {
                  "locations": [
                    {"location": {"physicalLocation": {"artifactLocation": {"uri": "src/main/java/lab/AuditPractice.java"}, "region": {"startLine": 10}}, "message": {"text": "方法参数 userInput 进入方法体"}}},
                    {"location": {"physicalLocation": {"artifactLocation": {"uri": "src/main/java/lab/AuditPractice.java"}, "region": {"startLine": 11}}, "message": {"text": "拼接进入 executeQuery 参数"}}}
                  ]
                }
              ]
            }
          ],
          "partialFingerprints": {"primaryLocationLineHash": "demo-sql-001"}
        },
        {
          "ruleId": "java/command-line-injection",
          "level": "error",
          "message": {"text": "{0} flows to {1}, allowing construction of an arbitrary command line.", "arguments": ["command", "Runtime.exec"]},
          "locations": [{"physicalLocation": {"artifactLocation": {"uri": "src/main/java/lab/AuditPractice.java"}, "region": {"startLine": 15, "startColumn": 9}}}],
          "codeFlows": [
            {
              "threadFlows": [
                {
                  "locations": [
                    {"location": {"physicalLocation": {"artifactLocation": {"uri": "src/main/java/lab/AuditPractice.java"}, "region": {"startLine": 14}}, "message": {"text": "方法参数 command 进入方法体"}}},
                    {"location": {"physicalLocation": {"artifactLocation": {"uri": "src/main/java/lab/AuditPractice.java"}, "region": {"startLine": 15}}, "message": {"text": "传入 Runtime.getRuntime().exec"}}}
                  ]
                }
              ]
            }
          ],
          "partialFingerprints": {"primaryLocationLineHash": "demo-cmd-001"}
        }
      ]
    }
  ]
}
