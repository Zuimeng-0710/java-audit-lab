{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Java Audit Lab corpus case",
  "type": "object",
  "required": [
    "case_id",
    "title",
    "category",
    "expected",
    "source",
    "license"
  ],
  "properties": {
    "case_id": {
      "type": "string",
      "pattern": "^[A-Z]+-[0-9]{3}$"
    },
    "title": {
      "type": "string"
    },
    "category": {
      "type": "string"
    },
    "expected": {
      "enum": [
        "vulnerable",
        "safe"
      ]
    },
    "expected_rules": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "forbidden_rules": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "expected_locations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "line"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "line": {
            "type": "integer",
            "minimum": 1
          },
          "rule_id": {
            "type": "string"
          }
        }
      }
    },
    "security_controls": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "scope": {
      "type": "string"
    },
    "frameworks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidence_level": {
      "type": "string"
    },
    "source": {
      "enum": [
        "synthetic",
        "desensitized",
        "open-source"
      ]
    },
    "derived_from": {
      "type": "string",
      "description": "source 为 desensitized 时注明真实素材出处（公开 CVE 分析、writeup 或开源项目）"
    },
    "license": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "expected": {
            "const": "vulnerable"
          }
        }
      },
      "then": {
        "required": [
          "expected_rules",
          "expected_locations"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "expected": {
            "const": "safe"
          }
        }
      },
      "then": {
        "required": [
          "forbidden_rules"
        ]
      }
    }
  ]
}
